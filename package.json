{
  "name": "sanity-template-template-nextjs-personal-website",
  "private": true,
  "scripts": {
    "build": "next build --turbopack && sanity manifest extract --path public/studio/static",
    "predev": "npm run typegen",
    "dev": "next --turbopack",
    "format": "npx prettier --write . --ignore-path .gitignore",
    "lint": "eslint .",
    "lint:fix": "npm run format && npm run lint -- --fix",
    "start": "next start",
    "type-check": "next typegen && tsc --noEmit",
    "typegen": "sanity schema extract && sanity typegen generate"
  },
  "dependencies": {
    "@next/env": "latest",
    "@sanity/client": "latest",
    "@sanity/color": "latest",
    "@sanity/demo": "latest",
    "@sanity/icons": "latest",
    "@sanity/image-url": "latest",
    "@sanity/ui": "latest",
    "@sanity/util": "latest",
    "@sanity/vision": "latest",
    "@tailwindcss/typography": "latest",
    "@vercel/speed-insights": "latest",
    "class-variance-authority": "^0.7.1",
    "classnames": "2.5.1",
    "clsx": "^2.1.1",
    "date-fns": "4.1.0",
    "jiti": "latest",
    "lucide-react": "^0.454.0",
    "next": "16.0.3",
    "next-sanity": "latest",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-is": "latest",
    "react-live-transitions": "0.2.0",
    "rxjs": "7.8.2",
    "sanity": "latest",
    "sanity-plugin-asset-source-unsplash": "latest",
    "server-only": "latest",
    "sonner": "latest",
    "styled-components": "6.1.19",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.0",
    "@sanity/prettier-config": "2.0.1",
    "@types/node": "^22",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.22",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.1",
    "eslint-formatter-gha": "1.6.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "postcss": "^8.5",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.7.1",
    "tailwindcss": "3.4.18",
    "typescript": "^5"
  }
}